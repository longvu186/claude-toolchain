{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','session-start-context.cjs'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='UserPromptSubmit'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','run-event-logger.cjs'))\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node -e \"try{require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','greenlight-approval.cjs'))}catch(e){}\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='UserPromptSubmit'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','tab-title-status.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','pre-tool-security.cjs'))\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','pre-tool-security.cjs'))\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','git-commit-gate.cjs'))\"",
            "timeout": 5,
            "statusMessage": "Checking GitNexus detect_changes requirement..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','strategic-compact-reminder.cjs'))\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='PreToolUse'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','run-event-logger.cjs'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='PostToolUse'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','run-event-logger.cjs'))\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='PostToolUse'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','tab-title-status.cjs'))\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','gitnexus-reindex.cjs'))\"",
            "timeout": 120,
            "statusMessage": "Re-indexing GitNexus...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','post-edit-format.cjs'))\"",
            "timeout": 15,
            "statusMessage": "Formatting..."
          }
        ]
      },
      {
        "matcher": "Bash|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','milestone-checkpoint-reminder.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='Notification'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','run-event-logger.cjs'))\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='Notification'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','tab-title-status.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='SubagentStop'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','run-event-logger.cjs'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='Stop'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','run-event-logger.cjs'))\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='Stop'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','tab-title-status.cjs'))\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','trigger-analysis-refresh.cjs'))\"",
            "timeout": 10,
            "statusMessage": "Queuing analysis refresh...",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','trigger-consolidation.cjs'))\"",
            "timeout": 10,
            "statusMessage": "Checking consolidation backlog...",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "You are a session-closure checker for Claude Code. Evaluate the LAST RESPONSE TURN only (not the full session history). Output {\"ok\": true} if ANY of these are true: (a) no tools were used this turn, (b) the only files written/edited this turn were memory files (paths containing .claude/projects/ or memory/ or MEMORY.md), (c) the turn was a summary or recap with no new code changes. Output {\"ok\": false, \"reason\": \"Session closure checklist:\\n1. Run the documentation-manager skill if docs, specs, or AI context files need updating (run logs, AGENTS.md, architecture docs).\\n2. Run the experience-memory-curator skill if there are durable lessons, preferences, or decisions worth promoting into long-term memories.\"} only if this turn made substantive changes to code, hook scripts, configs, or project docs that have NOT yet been captured in memory/run logs. Default to {\"ok\": true} when uncertain. Hook context: $ARGUMENTS",
            "timeout": 30,
            "statusMessage": "Checking session closure tasks..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','precompact-checkpoint-reminder.cjs'))\"",
            "timeout": 10,
            "statusMessage": "Checking for undocumented progress before compaction..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='SessionEnd'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','run-event-logger.cjs'))\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node -e \"process.argv[2]='SessionEnd'; require(require('node:path').join(process.env.USERPROFILE||process.env.HOME,'.claude','hooks','scripts','tab-title-status.cjs'))\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
